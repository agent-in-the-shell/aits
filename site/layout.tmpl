{{/* The layout of the pages generated from docs/: cli.html and principles.html. go test ./cmd/aits -run TestSitePages -update */ -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="{{.Description}}">
<meta property="og:type" content="article">
<meta property="og:site_name" content="aits">
<meta property="og:title" content="{{.OGTitle}}">
<meta property="og:description" content="{{.Description}}">
<meta property="og:image" content="https://agent-in-the-shell.github.io/aits/og.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{.OGTitle}}">
<meta name="twitter:description" content="{{.Description}}">
<meta name="theme-color" content="#ecebe5" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0b0d14" media="(prefers-color-scheme: dark)">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="site.css">
<link rel="stylesheet" href="base.css">
<script>try{var t=localStorage.getItem('aits-theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
</head>
<body class="doc-page">
<div class="vt-edge" aria-hidden="true"></div>
<a class="skip" href="#main">Skip to content</a>

<header class="bar">
  <div class="wrap">
    <a class="logo" href="index.html" aria-label="aits home">
      <span class="wm">aits</span><span class="cur" aria-hidden="true"></span>
    </a>
    <span class="tag">pre-release</span>
    <nav class="nav" aria-label="Site">
      <span class="sub"><a href="index.html#commands">Commands</a><a href="index.html#usage">Usage</a><a href="index.html#agents">For agents</a></span>
      <a href="cli.html"{{if eq .Page "cli"}} aria-current="page"{{end}}>CLI<span class="lg"> reference</span></a>
      <a href="principles.html"{{if eq .Page "principles"}} aria-current="page"{{end}}>Principles</a>
    </nav>
    <a class="gh" href="https://github.com/agent-in-the-shell/aits" aria-label="aits on GitHub">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      <span>GitHub</span>
    </a>
    <button class="theme" id="theme" type="button" aria-label="Switch color theme">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5a6.5 6.5 0 010 13z" fill="currentColor"/></svg>
    </button>
  </div>
  <div class="fuse" aria-hidden="true"></div>
</header>

<main id="main">
{{.Body}}
</main>

<p class="totop wrap"><a href="#top">Back to top <span aria-hidden="true">&#8593;</span></a></p>
<footer>
  <div class="wrap">
    <div class="f1">
      <a class="logo f-logo" href="index.html" aria-label="aits home"><span class="wm">aits</span><span class="cur" aria-hidden="true"></span></a>
      <div class="f-inst"><code><span class="p">$ </span>go install <span class="nb">github.com/</span><wbr><span class="nb">agent-in-the-shell/</span><wbr><span class="nb">aits/cmd/</span><wbr><span class="nb">aits@latest</span></code><button class="copy" type="button" data-copy="go install github.com/agent-in-the-shell/aits/cmd/aits@latest" aria-label="Copy install command">Copy</button></div>
      <span class="f-meta">pre-release &#183; MIT</span>
    </div>
    <nav class="f2" aria-label="Footer">
      <a href="index.html">Home</a>
      <a href="cli.html">CLI reference</a>
      <a href="principles.html">Principles</a>
      <a href="https://github.com/agent-in-the-shell/aits/blob/main/CONTRIBUTING.md">Contributing</a>
      <a href="https://github.com/agent-in-the-shell/aits">GitHub</a>
      <a href="https://github.com/agent-in-the-shell/aits/blob/main/LICENSE">License</a>
    </nav>
  </div>
</footer>
<script src="site.js"></script>
<script src="base.js"></script>
</body>
</html>
